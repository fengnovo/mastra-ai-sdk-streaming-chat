# =========================
# LLM: any OpenAI-compatible endpoint
# =========================
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-me
AI_MODEL=gpt-5-mini

# DeepSeek example:
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=sk-xxxxxxxx
# AI_MODEL=deepseek-v4-flash

# Alibaba Bailian / DashScope example:
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_API_KEY=sk-xxxxxxxx
# AI_MODEL=qwen-plus

# =========================
# Real web search (Tavily)
# Without this key the rest of the project still runs;
# webSearch will return a clear "not configured" result.
# =========================
TAVILY_API_KEY=

# =========================
# Agent local workspace
# Filesystem tools are sandboxed under this directory.
# Relative path resolves from project root.
# =========================
AGENT_WORKSPACE_ROOT=./workspace

# run_command has basic destructive-command guards by default.
# Set to true only in a disposable/local sandbox if you want unrestricted shell commands.
ALLOW_UNSAFE_COMMANDS=false

# Existing infrastructure: /Users/keen/Desktop/code/projects/chat/infra/compose.yaml
# 55433 is that stack's postgres-test instance. Use a dedicated database here.
DATABASE_URL=postgresql://agent:agent@127.0.0.1:55433/mastra_streaming_chat
# Redis logical DB 15 is reserved for this project; do not use DB 0.
REDIS_URL=redis://127.0.0.1:56379/15

# Next.js proxies chat to the local Mastra API.
MASTRA_API_URL=http://127.0.0.1:4111
# API and Worker modes are set by their pnpm scripts.
MASTRA_STEP_EXECUTION_URL=http://127.0.0.1:4111/api
