# =========================
# LLM: any OpenAI-compatible endpoint
# =========================
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-me
AI_MODEL=gpt-5-mini

# DeepSeek example:
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=sk-xxxxxxxx
# AI_MODEL=deepseek-v4-flash

# Alibaba Bailian / DashScope example:
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_API_KEY=sk-xxxxxxxx
# AI_MODEL=qwen-plus

# =========================
# Real web search (Tavily)
# Without this key the rest of the project still runs;
# webSearch will return a clear "not configured" result.
# =========================
TAVILY_API_KEY=

# =========================
# Agent local workspace
# Filesystem tools are sandboxed under this directory.
# Relative path resolves from project root.
# =========================
AGENT_WORKSPACE_ROOT=./workspace

# run_command has basic destructive-command guards by default.
# Set to true only in a disposable/local sandbox if you want unrestricted shell commands.
ALLOW_UNSAFE_COMMANDS=false

# =========================
# Mastra storage
# =========================
MASTRA_DB_URL=file:./data/mastra.db
